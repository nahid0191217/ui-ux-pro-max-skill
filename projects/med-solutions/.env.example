APP_NAME="Med Solutions"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=med_solutions_db
DB_USERNAME=medsolutions_user
DB_PASSWORD=

FILESYSTEM_DISK=local

# Quick role switcher for PREVIEW/DEMO only. Keep false on any real deployment.
DEMO_ROLE_SWITCHER=false
MEDICAL_REPORTS_DISK=private

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Required when the app is shown inside another site's iframe (e.g. the Arena preview).
# SameSite=None only works together with Secure cookies (HTTPS).
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none

QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@example.com"
MAIL_FROM_NAME="${APP_NAME}"
